{
  "name": "@applyai/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && mkdir -p dist/modules/ai && cp -R src/modules/ai/prompts dist/modules/ai/prompts",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "test": "jest --runInBand --watchman=false",
    "test:watch": "jest --watch --watchman=false",
    "test:coverage": "jest --coverage --runInBand --watchman=false",
    "test:integration": "tsc -p tsconfig.integration.json --noEmit && jest --config jest.integration.json --runInBand --watchman=false",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "prisma:generate": "prisma generate --schema src/database/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema src/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema src/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.25.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@google/generative-ai": "^0.16.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "^5.18.0",
    "argon2": "^0.40.0",
    "bullmq": "^5.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "5.2.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.0",
    "mammoth": "^1.8.0",
    "nodemailer": "9.0.3",
    "openai": "^4.55.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "prisma": "^5.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^16.6.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@playwright/test": "^1.46.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "rimraf": "6.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "watchman": false
  }
}
