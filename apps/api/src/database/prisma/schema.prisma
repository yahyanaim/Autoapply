generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  org_admin
  platform_admin
}

enum UserStatus {
  active
  suspended
}

enum ApplicationStatus {
  draft
  submitted
  viewed
  interview
  offer
  rejected
}

enum ApplicationPreparationStatus {
  job_captured
  analyzing
  generating
  ready_for_review
  ready_to_submit
  generation_failed
}

enum SubscriptionPlan {
  free
  pro
  premium
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
  incomplete
  incomplete_expired
  unpaid
  paused
}

enum PaymentStatus {
  succeeded
  pending
  failed
  refunded
}

enum SubscriptionLifecycleEventCategory {
  paid_activation
  plan_upgrade
  plan_downgrade
  cancellation
  reactivation
  trial_start
  trial_conversion
  past_due_transition
  pause_transition
  unpaid_transition
  subscription_deletion
  observation
}

enum AIRequestFeature {
  resume_parse
  job_analyze
  resume_optimize
  match_score
  cover_letter
  interview_coach
  career_advisor
  recruiter_chat
}

enum NotificationChannel {
  email
  push
  in_app
}

enum NotificationStatus {
  pending
  sent
  failed
  read
}

enum ResumeParseStatus {
  pending
  processing
  ready
  failed
}

enum ResumeParseExecutionStatus {
  requeue_requested
  queued
  processing
  retrying
  succeeded
  failed_requeueable
  failed_permanent
}

enum ResumeParseFailureCategory {
  provider_transient
  storage_transient
  worker_crash
  document_unreadable
  document_empty
  provider_response_invalid
  provider_configuration
  authorization
  entitlement_changed
  record_missing
  internal_unknown
  legacy_unclassified
}

enum ResumeParseDispatchStatus {
  pending
  dispatching
  dispatched
}

enum ResumeRequeueReason {
  provider_recovered
  storage_recovered
  worker_recovery
}

enum ResumeParseExecutionOrigin {
  initial
  admin_requeue
}

enum RemoteType {
  remote
  hybrid
  onsite
}

enum JobStatus {
  active
  deactivated
}

enum JobDeactivationReason {
  provider_removed
  invalid_listing
  duplicate
  policy_violation
  security_risk
  other
}

enum OAuthProvider {
  google
  github
}

enum SessionClientType {
  web
  extension
}

enum IdempotencyStatus {
  pending
  completed
}

enum ActivityType {
  auth_login
  auth_login_failed
  auth_account_locked
  auth_logout
  auth_token_reuse
  resume_upload
  resume_optimize
  application_create
  application_update
  cover_letter_generate
  ai_request
  subscription_change
  payment
  access_denied
  admin_activity_log_read
  admin_user_suspend
  admin_user_reactivate
  admin_session_revoke
  admin_session_revoke_all
  admin_job_deactivate
  admin_resume_requeue
  queue_job
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String?
  role                    UserRole  @default(user)
  status                  UserStatus @default(active)
  suspendedAt             DateTime?
  suspendedByUserId       String?
  suspensionReason        String?
  isEmailVerified         Boolean   @default(false)
  dataProcessingConsentAt DateTime?
  privacyPolicyVersion    String?
  mfaSecretEncrypted      String?
  mfaEnabledAt            DateTime?
  mfaLastUsedStep         Int?
  failedLoginAttempts     Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  profile               Profile?
  resumes               Resume[]
  applications          Application[]
  coverLetters          CoverLetter[]
  subscription          Subscription?
  aiRequests            AIRequest[]
  notifications         Notification[]
  activityLogs          ActivityLog[]
  sessions              Session[]
  usageLimit            UsageLimit?
  oauthAccounts         OAuthAccount[]
  extensionAuthHandoffs ExtensionAuthHandoff[]
  capturedJobs          Job[]                  @relation("CapturedJobs")
  deactivatedJobs       Job[]                  @relation("DeactivatedJobs")
  requestedResumeRequeues ResumeParseExecution[] @relation("ResumeRequeueRequestedBy")
  refreshTokenHistory   RefreshTokenHistory[]
  idempotencyRecords    IdempotencyRecord[]

  @@index([email])
  @@index([status, createdAt])
  @@map("users")
}

model BetaRegistrationGate {
  id        String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("beta_registration_gate")
}

model ExtensionAuthHandoff {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("extension_auth_handoffs")
}

model OAuthAccount {
  id           String        @id @default(cuid())
  userId       String
  provider     OAuthProvider
  providerId   String
  accessToken  String?
  refreshToken String?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model Profile {
  id               String      @id @default(cuid())
  userId           String      @unique
  fullName         String?
  headline         String?
  location         String?
  phone            String?
  linkedInUrl      String?
  portfolioUrl     String?
  visaStatus       String?
  desiredSalaryMin Int?
  desiredSalaryMax Int?
  remotePreference RemoteType?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Resume {
  id              String            @id @default(cuid())
  userId          String
  originalFileUrl String
  parsedJson      Json?
  parseStatus     ResumeParseStatus @default(pending)
  parseError      String?
  isPrimary       Boolean           @default(false)
  fileName        String?
  fileSize        Int?
  mimeType        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  applications Application[]
  skills       Skill[]           @relation("ResumeSkills")
  matchScores  MatchScoreCache[]
  parseExecutionClaims ResumeParseExecutionClaim[]
  parseExecutions ResumeParseExecution[]

  @@index([userId])
  @@map("resumes")
}

// A durable, minimal record of each signed queue delivery admitted to resume
// parsing. The stable queue/job identity protects against copied work being
// executed twice; a later BullMQ attempt must first consume a retry
// authorization recorded after a real retryable failure.
// Rows are retained until the resume is deleted, rather than expiring and
// reopening the replay window.
model ResumeParseExecutionClaim {
  id        String   @id @default(cuid())
  resumeId  String
  executionId String? @unique
  queueName String
  jobId     String
  attempt   Int
  retryAuthorizedAttempt Int?
  claimedAt DateTime @default(now())
  leaseVersion Int @default(0)
  leaseExpiresAt DateTime?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  execution ResumeParseExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([queueName, jobId])
  @@index([resumeId])
  @@map("resume_parse_execution_claims")
}

model ResumeParseExecution {
  id                     String                     @id @default(cuid())
  resumeId               String
  predecessorExecutionId String?                    @unique
  generation             Int
  origin                 ResumeParseExecutionOrigin
  executionBoundary      String
  status                 ResumeParseExecutionStatus
  failureCategory        ResumeParseFailureCategory?
  attemptCount           Int                        @default(0)
  maxAttempts            Int                        @default(3)
  queueName              String
  queueJobId             String                     @unique
  requestedByUserId      String?
  requeueReason          ResumeRequeueReason?
  idempotencyKeyHash     String?
  requestFingerprint     String?
  requestedAt            DateTime                   @default(now())
  queuedAt               DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  resume       Resume                       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  requestedBy  User?                        @relation("ResumeRequeueRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  predecessor  ResumeParseExecution?        @relation("ResumeExecutionChain", fields: [predecessorExecutionId], references: [id], onDelete: Restrict)
  successor    ResumeParseExecution?        @relation("ResumeExecutionChain")
  claim        ResumeParseExecutionClaim?
  dispatch     ResumeParseDispatch?

  @@unique([resumeId, generation])
  @@unique([requestedByUserId, idempotencyKeyHash])
  @@index([resumeId, createdAt])
  @@index([status, failedAt])
  @@map("resume_parse_executions")
}

model ResumeParseDispatch {
  id                String                    @id @default(cuid())
  executionId       String                    @unique
  status            ResumeParseDispatchStatus @default(pending)
  attemptCount      Int                       @default(0)
  availableAt       DateTime                  @default(now())
  leaseExpiresAt    DateTime?
  dispatchedAt      DateTime?
  lastErrorCategory String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  execution ResumeParseExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@map("resume_parse_dispatches")
}

model MatchScoreCache {
  id               String   @id @default(cuid())
  resumeId         String
  inputHash        String   @unique
  algorithmVersion String
  score            Int
  confidence       Int
  matchedKeywords  String[]
  missingKeywords  String[]
  weakSections     String[]
  breakdown        Json
  explanation      String[]
  createdAt        DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("match_score_cache")
}

model ResumeVersion {
  id               String   @id @default(cuid())
  resumeId         String
  jobId            String?
  optimizedFileUrl String?
  optimizedText    String?  @db.Text
  documentJson     Json?
  matchScore       Float?
  missingKeywords  String[]
  weakSections     String[]
  generatedAt      DateTime @default(now())

  resume       Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job          Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applications Application[]
  coverLetters CoverLetter[]

  @@index([resumeId])
  @@map("resume_versions")
}

model Skill {
  id   String @id @default(cuid())
  name String @unique

  jobs    Job[]    @relation("JobSkills")
  resumes Resume[] @relation("ResumeSkills")

  @@map("skills")
}

model Company {
  id        String  @id @default(cuid())
  name      String  @unique
  domain    String?
  sizeRange String?
  industry  String?

  jobs Job[]

  @@map("companies")
}

model Job {
  id               String      @id @default(cuid())
  source           String?
  sourceUrl        String?
  sourceKey        String?     @unique
  title            String
  companyId        String?
  capturedByUserId String?
  description      String?
  location         String?
  remoteType       RemoteType?
  salaryMin        Int?
  salaryMax        Int?
  status               JobStatus @default(active)
  deactivatedAt        DateTime?
  deactivatedByUserId  String?
  deactivationReason   JobDeactivationReason?
  scrapedAt        DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  capturedBy     User?           @relation("CapturedJobs", fields: [capturedByUserId], references: [id], onDelete: Cascade)
  deactivatedBy  User?           @relation("DeactivatedJobs", fields: [deactivatedByUserId], references: [id], onDelete: SetNull)
  applications   Application[]
  resumeVersions ResumeVersion[]
  skills         Skill[]         @relation("JobSkills")

  @@index([companyId])
  @@index([capturedByUserId])
  @@index([deactivatedByUserId])
  @@index([status, scrapedAt])
  @@index([sourceUrl])
  @@map("jobs")
}

model Application {
  id                      String                       @id @default(cuid())
  userId                  String
  jobId                   String
  sourceResumeId          String?
  resumeVersionId         String?
  coverLetterId           String?
  status                  ApplicationStatus            @default(draft)
  preparationStatus       ApplicationPreparationStatus @default(job_captured)
  jobAnalysis             Json?
  generationError         String?
  approvedAt              DateTime?
  approvedResumeHash      String?
  approvedCoverLetterHash String?
  idempotencyKey          String?
  idempotencyFingerprint  String?
  appliedAt               DateTime?
  source                  String?
  screenshotUrl           String?
  timeline                Json?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceResume  Resume?        @relation(fields: [sourceResumeId], references: [id], onDelete: SetNull)
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  coverLetter   CoverLetter?   @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([jobId])
  @@index([sourceResumeId])
  @@index([status])
  @@map("applications")
}

model CoverLetter {
  id              String   @id @default(cuid())
  userId          String
  jobId           String?
  resumeVersionId String?
  content         String
  tone            String?
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  applications  Application[]

  @@index([userId])
  @@index([resumeVersionId])
  @@map("cover_letters")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(free)
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(cuid())
  subscriptionId  String
  amount          Int
  currency        String        @default("usd")
  status          PaymentStatus @default(pending)
  stripePaymentId String?       @unique
  invoiceUrl      String?
  createdAt       DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("payments")
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())

  lifecycleEvent SubscriptionLifecycleEvent?

  @@map("stripe_webhook_events")
}

model SubscriptionLifecycleEvent {
  id                    String                             @id @default(cuid())
  sequence              BigInt                             @unique @default(autoincrement())
  // Opaque Billing identity retained even if the source Subscription is deleted.
  subscriptionId        String
  sourceStripeEventId   String                             @unique
  category              SubscriptionLifecycleEventCategory
  previousStatus        SubscriptionStatus
  nextStatus            SubscriptionStatus
  previousPlan          SubscriptionPlan
  nextPlan              SubscriptionPlan
  previousPriceUsdMinor Int?
  nextPriceUsdMinor     Int?
  currency              String                             @default("usd")
  effectiveAt           DateTime
  observedAt            DateTime                           @default(now())

  sourceEvent  StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@index([subscriptionId, effectiveAt, sequence])
  @@index([effectiveAt, sequence])
  @@index([category, effectiveAt])
  @@map("subscription_lifecycle_events")
}

model BillingMetricsHistoryBoundary {
  id                                  String   @id
  historyAvailableFrom                DateTime
  currency                            String   @default("usd")
  baselineActivePaidSubscriptions     Int
  baselineActiveProSubscriptions      Int
  baselineActivePremiumSubscriptions  Int
  baselineMonthlyRecurringRevenueMinor Int
  createdAt                           DateTime @default(now())

  @@map("billing_metrics_history_boundaries")
}

model BillingDailySubscriptionMetric {
  id                         String   @id @default(cuid())
  day                        DateTime
  currency                   String   @default("usd")
  activePaidDelta            Int      @default(0)
  activeProDelta             Int      @default(0)
  activePremiumDelta         Int      @default(0)
  monthlyRecurringRevenueDeltaMinor Int @default(0)
  newPaidSubscriptions       Int      @default(0)
  expansionMrrMinor          Int      @default(0)
  contractionMrrMinor        Int      @default(0)
  churnCount                 Int      @default(0)
  churnedMrrMinor            Int      @default(0)
  reactivationCount          Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([day, currency])
  @@index([day])
  @@map("billing_daily_subscription_metrics")
}

model AIRequest {
  id            String           @id @default(cuid())
  userId        String
  feature       AIRequestFeature
  provider      String
  model         String?
  promptVersion String?
  tokensUsed    Int?
  cost          Float?
  latencyMs     Int?
  inputHash     String?
  cached        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@index([inputHash])
  @@map("ai_requests")
}

model UsageLimit {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  period                  String
  applicationsUsed        Int      @default(0)
  applicationsMax         Int      @default(10)
  aiRequestsUsed          Int      @default(0)
  aiRequestsMax           Int      @default(5)
  resumeOptimizationsUsed Int      @default(0)
  resumeOptimizationsMax  Int      @default(1)
  jobDiscoveriesUsed      Int      @default(0)
  jobDiscoveriesMax       Int      @default(3)
  resumesUsed             Int      @default(0)
  resumesMax              Int      @default(1)
  storageBytesUsed        Int      @default(0)
  storageBytesMax         Int      @default(5242880)
  resetAt                 DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_limits")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(in_app)
  title     String
  body      String?
  link      String?
  status    NotificationStatus  @default(pending)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String?
  type      ActivityType
  metadata  Json?
  ipAddress String?
  userAgent String?
  actorUserId String?
  targetType String?
  targetId String?
  action String?
  before Json?
  after Json?
  correlationId String?
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("activity_logs")
}

model Session {
  id                String            @id @default(cuid())
  userId            String
  token             String            @unique
  userAgent         String?
  ipAddress         String?
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  mfaVerifiedAt     DateTime?
  clientType        SessionClientType @default(web)
  lastUsedAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model RefreshTokenHistory {
  id         String    @id @default(cuid())
  sessionId  String
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime  @default(now())
  detectedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token_history")
}

model IdempotencyRecord {
  id          String            @id @default(cuid())
  userId      String
  key         String
  operation   String
  fingerprint String
  status      IdempotencyStatus @default(pending)
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AdminStepUpMfaProof {
  id          String   @id @default(cuid())
  proofHash   String   @unique
  actorUserId String
  sessionId   String
  action      String
  targetType  String
  targetId    String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([actorUserId, sessionId, action, targetType, targetId, expiresAt])
  @@map("admin_step_up_mfa_proofs")
}

model AdminStepUpMfaAttempt {
  id              String   @id @default(cuid())
  actorUserId     String
  sessionId       String
  action          String
  targetType      String
  targetId        String
  failedAttempts  Int      @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([actorUserId, sessionId, action, targetType, targetId])
  @@index([lockedUntil])
  @@map("admin_step_up_mfa_attempts")
}
