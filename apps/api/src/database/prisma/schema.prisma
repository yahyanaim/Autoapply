generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  org_admin
  platform_admin
}

enum UserStatus {
  active
  suspended
}

enum ApplicationStatus {
  draft
  submitted
  viewed
  interview
  offer
  rejected
}

enum ApplicationPreparationStatus {
  job_captured
  analyzing
  generating
  ready_for_review
  ready_to_submit
  generation_failed
}

enum SubscriptionPlan {
  free
  pro
  premium
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
  incomplete
  incomplete_expired
  unpaid
  paused
}

enum PaymentStatus {
  succeeded
  pending
  failed
  refunded
}

enum SubscriptionLifecycleEventCategory {
  paid_activation
  plan_upgrade
  plan_downgrade
  cancellation
  reactivation
  trial_start
  trial_conversion
  past_due_transition
  pause_transition
  unpaid_transition
  subscription_deletion
  observation
}

enum BillingFinancialEventCategory {
  gross_revenue
}

enum BillingRefundStatus {
  pending
  requires_action
  succeeded
  failed
  canceled
}

enum BillingRefundCurrencySupport {
  usd
  unsupported
}

enum BillingDisputeStatus {
  warning_needs_response
  warning_under_review
  warning_closed
  needs_response
  under_review
  won
  lost
}

enum BillingDisputeObservationType {
  created
  updated
  closed
  funds_withdrawn
  funds_reinstated
}

enum BillingDisputeObservationResolution {
  status_only
  movement_recorded
  duplicate_movement
  missing_authoritative_transaction
  unsupported_currency
  pre_boundary
}

enum BillingDisputeMovementKind {
  withdrawal
  reinstatement
}

enum BillingStripeFeeResolution {
  recorded
  duplicate_balance_transaction
  zero_fee
  unsupported_currency
  pre_boundary
  missing_authoritative_transaction
  missing_authoritative_fee
}

enum BillingEvidenceComponent {
  stripe_fee
  dispute_movement
}

enum BillingEvidenceState {
  pending
  resolved_effect
  resolved_zero
  excluded_non_usd
  excluded_pre_boundary
  excluded_duplicate
}

enum BillingEventScanStatus {
  completed
  incomplete
  failed
  unavailable
}

enum BillingEventScanFinding {
  missing_receipt
  missing_gross_effect
  missing_refund_observation
  missing_refund_effect
  missing_dispute_observation
  missing_fee_observation
  missing_recorded_fee_effect
  missing_dispute_effect
  unresolved_evidence
}

enum BillingInvoiceFinancialOutcomeStatus {
  eligible
  excluded_no_local_subscription
}

enum BillingVerifiedWebhookState {
  processing
  retryable_failure
  unclassified_failure
  resolved
}

enum BillingVerifiedWebhookReason {
  provider_unavailable
  processing_error
}

enum AiCostIntentState {
  pending
  costed
  uncosted
}

enum AiCostEventKind {
  estimate
  resolution
}

enum QuotaGrantCategory {
  applications
  ai_requests
  resume_optimizations
  job_discoveries
  resumes
  storage_bytes
}

enum QuotaGrantReason {
  customer_support
  service_recovery
  beta_program
}

enum AIRequestFeature {
  resume_parse
  job_analyze
  resume_optimize
  match_score
  cover_letter
  interview_coach
  career_advisor
  recruiter_chat
}

enum NotificationChannel {
  email
  push
  in_app
}

enum NotificationStatus {
  pending
  sent
  failed
  read
}

enum ResumeParseStatus {
  pending
  processing
  ready
  failed
}

enum ResumeParseExecutionStatus {
  requeue_requested
  queued
  processing
  retrying
  succeeded
  failed_requeueable
  failed_permanent
}

enum ResumeParseFailureCategory {
  provider_transient
  storage_transient
  worker_crash
  document_unreadable
  document_empty
  provider_response_invalid
  provider_configuration
  authorization
  entitlement_changed
  record_missing
  internal_unknown
  legacy_unclassified
}

enum ResumeParseDispatchStatus {
  pending
  dispatching
  dispatched
}

enum ResumeRequeueReason {
  provider_recovered
  storage_recovered
  worker_recovery
}

enum ResumeParseExecutionOrigin {
  initial
  admin_requeue
}

enum RemoteType {
  remote
  hybrid
  onsite
}

enum JobStatus {
  active
  deactivated
}

enum JobDeactivationReason {
  provider_removed
  invalid_listing
  duplicate
  policy_violation
  security_risk
  other
}

enum OAuthProvider {
  google
  github
}

enum SessionClientType {
  web
  extension
}

enum IdempotencyStatus {
  pending
  completed
}

enum ActivityType {
  auth_login
  auth_login_failed
  auth_account_locked
  auth_logout
  auth_token_reuse
  resume_upload
  resume_optimize
  application_create
  application_update
  cover_letter_generate
  ai_request
  subscription_change
  payment
  access_denied
  admin_activity_log_read
  admin_user_suspend
  admin_user_reactivate
  admin_session_revoke
  admin_session_revoke_all
  admin_job_deactivate
  admin_resume_requeue
  admin_quota_grant
  admin_webhook_retry
  queue_job
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String?
  role                    UserRole  @default(user)
  status                  UserStatus @default(active)
  suspendedAt             DateTime?
  suspendedByUserId       String?
  suspensionReason        String?
  isEmailVerified         Boolean   @default(false)
  dataProcessingConsentAt DateTime?
  privacyPolicyVersion    String?
  mfaSecretEncrypted      String?
  mfaEnabledAt            DateTime?
  mfaLastUsedStep         Int?
  failedLoginAttempts     Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  profile               Profile?
  resumes               Resume[]
  applications          Application[]
  coverLetters          CoverLetter[]
  subscription          Subscription?
  aiRequests            AIRequest[]
  notifications         Notification[]
  activityLogs          ActivityLog[]
  sessions              Session[]
  usageLimit            UsageLimit?
  oauthAccounts         OAuthAccount[]
  extensionAuthHandoffs ExtensionAuthHandoff[]
  capturedJobs          Job[]                  @relation("CapturedJobs")
  deactivatedJobs       Job[]                  @relation("DeactivatedJobs")
  requestedResumeRequeues ResumeParseExecution[] @relation("ResumeRequeueRequestedBy")
  refreshTokenHistory   RefreshTokenHistory[]
  idempotencyRecords    IdempotencyRecord[]
  quotaGrants           QuotaGrant[]             @relation("QuotaGrantTarget")
  grantedQuotaGrants    QuotaGrant[]             @relation("QuotaGrantActor")

  @@index([email])
  @@index([status, createdAt])
  @@map("users")
}

model BetaRegistrationGate {
  id        String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("beta_registration_gate")
}

model ExtensionAuthHandoff {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("extension_auth_handoffs")
}

model OAuthAccount {
  id           String        @id @default(cuid())
  userId       String
  provider     OAuthProvider
  providerId   String
  accessToken  String?
  refreshToken String?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model Profile {
  id               String      @id @default(cuid())
  userId           String      @unique
  fullName         String?
  headline         String?
  location         String?
  phone            String?
  linkedInUrl      String?
  portfolioUrl     String?
  visaStatus       String?
  desiredSalaryMin Int?
  desiredSalaryMax Int?
  remotePreference RemoteType?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Resume {
  id              String            @id @default(cuid())
  userId          String
  originalFileUrl String
  parsedJson      Json?
  parseStatus     ResumeParseStatus @default(pending)
  parseError      String?
  isPrimary       Boolean           @default(false)
  fileName        String?
  fileSize        Int?
  mimeType        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  applications Application[]
  skills       Skill[]           @relation("ResumeSkills")
  matchScores  MatchScoreCache[]
  parseExecutionClaims ResumeParseExecutionClaim[]
  parseExecutions ResumeParseExecution[]

  @@index([userId])
  @@map("resumes")
}

// A durable, minimal record of each signed queue delivery admitted to resume
// parsing. The stable queue/job identity protects against copied work being
// executed twice; a later BullMQ attempt must first consume a retry
// authorization recorded after a real retryable failure.
// Rows are retained until the resume is deleted, rather than expiring and
// reopening the replay window.
model ResumeParseExecutionClaim {
  id        String   @id @default(cuid())
  resumeId  String
  executionId String? @unique
  queueName String
  jobId     String
  attempt   Int
  retryAuthorizedAttempt Int?
  claimedAt DateTime @default(now())
  leaseVersion Int @default(0)
  leaseExpiresAt DateTime?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  execution ResumeParseExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([queueName, jobId])
  @@index([resumeId])
  @@map("resume_parse_execution_claims")
}

model ResumeParseExecution {
  id                     String                     @id @default(cuid())
  resumeId               String
  predecessorExecutionId String?                    @unique
  generation             Int
  origin                 ResumeParseExecutionOrigin
  executionBoundary      String
  status                 ResumeParseExecutionStatus
  failureCategory        ResumeParseFailureCategory?
  attemptCount           Int                        @default(0)
  maxAttempts            Int                        @default(3)
  queueName              String
  queueJobId             String                     @unique
  requestedByUserId      String?
  requeueReason          ResumeRequeueReason?
  idempotencyKeyHash     String?
  requestFingerprint     String?
  requestedAt            DateTime                   @default(now())
  queuedAt               DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  resume       Resume                       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  requestedBy  User?                        @relation("ResumeRequeueRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  predecessor  ResumeParseExecution?        @relation("ResumeExecutionChain", fields: [predecessorExecutionId], references: [id], onDelete: Restrict)
  successor    ResumeParseExecution?        @relation("ResumeExecutionChain")
  claim        ResumeParseExecutionClaim?
  dispatch     ResumeParseDispatch?

  @@unique([resumeId, generation])
  @@unique([requestedByUserId, idempotencyKeyHash])
  @@index([resumeId, createdAt])
  @@index([status, failedAt])
  @@map("resume_parse_executions")
}

model ResumeParseDispatch {
  id                String                    @id @default(cuid())
  executionId       String                    @unique
  status            ResumeParseDispatchStatus @default(pending)
  attemptCount      Int                       @default(0)
  availableAt       DateTime                  @default(now())
  leaseExpiresAt    DateTime?
  dispatchedAt      DateTime?
  lastErrorCategory String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  execution ResumeParseExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@map("resume_parse_dispatches")
}

model MatchScoreCache {
  id               String   @id @default(cuid())
  resumeId         String
  inputHash        String   @unique
  algorithmVersion String
  score            Int
  confidence       Int
  matchedKeywords  String[]
  missingKeywords  String[]
  weakSections     String[]
  breakdown        Json
  explanation      String[]
  createdAt        DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("match_score_cache")
}

model ResumeVersion {
  id               String   @id @default(cuid())
  resumeId         String
  jobId            String?
  optimizedFileUrl String?
  optimizedText    String?  @db.Text
  documentJson     Json?
  matchScore       Float?
  missingKeywords  String[]
  weakSections     String[]
  generatedAt      DateTime @default(now())

  resume       Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job          Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applications Application[]
  coverLetters CoverLetter[]

  @@index([resumeId])
  @@map("resume_versions")
}

model Skill {
  id   String @id @default(cuid())
  name String @unique

  jobs    Job[]    @relation("JobSkills")
  resumes Resume[] @relation("ResumeSkills")

  @@map("skills")
}

model Company {
  id        String  @id @default(cuid())
  name      String  @unique
  domain    String?
  sizeRange String?
  industry  String?

  jobs Job[]

  @@map("companies")
}

model Job {
  id               String      @id @default(cuid())
  source           String?
  sourceUrl        String?
  sourceKey        String?     @unique
  title            String
  companyId        String?
  capturedByUserId String?
  description      String?
  location         String?
  remoteType       RemoteType?
  salaryMin        Int?
  salaryMax        Int?
  status               JobStatus @default(active)
  deactivatedAt        DateTime?
  deactivatedByUserId  String?
  deactivationReason   JobDeactivationReason?
  scrapedAt        DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  capturedBy     User?           @relation("CapturedJobs", fields: [capturedByUserId], references: [id], onDelete: Cascade)
  deactivatedBy  User?           @relation("DeactivatedJobs", fields: [deactivatedByUserId], references: [id], onDelete: SetNull)
  applications   Application[]
  resumeVersions ResumeVersion[]
  skills         Skill[]         @relation("JobSkills")

  @@index([companyId])
  @@index([capturedByUserId])
  @@index([deactivatedByUserId])
  @@index([status, scrapedAt])
  @@index([sourceUrl])
  @@map("jobs")
}

model Application {
  id                      String                       @id @default(cuid())
  userId                  String
  jobId                   String
  sourceResumeId          String?
  resumeVersionId         String?
  coverLetterId           String?
  status                  ApplicationStatus            @default(draft)
  preparationStatus       ApplicationPreparationStatus @default(job_captured)
  jobAnalysis             Json?
  generationError         String?
  approvedAt              DateTime?
  approvedResumeHash      String?
  approvedCoverLetterHash String?
  idempotencyKey          String?
  idempotencyFingerprint  String?
  appliedAt               DateTime?
  source                  String?
  screenshotUrl           String?
  timeline                Json?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceResume  Resume?        @relation(fields: [sourceResumeId], references: [id], onDelete: SetNull)
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  coverLetter   CoverLetter?   @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([jobId])
  @@index([sourceResumeId])
  @@index([status])
  @@map("applications")
}

model CoverLetter {
  id              String   @id @default(cuid())
  userId          String
  jobId           String?
  resumeVersionId String?
  content         String
  tone            String?
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  applications  Application[]

  @@index([userId])
  @@index([resumeVersionId])
  @@map("cover_letters")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(free)
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(cuid())
  subscriptionId  String
  amount          Int
  currency        String        @default("usd")
  status          PaymentStatus @default(pending)
  stripePaymentId String?       @unique
  invoiceUrl      String?
  createdAt       DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("payments")
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())

  lifecycleEvent SubscriptionLifecycleEvent?
  financialEvent BillingFinancialEvent?
  refundObservation BillingRefundObservation?
  refundEffect BillingRefundEffect?
  disputeObservation BillingDisputeObservation?
  disputeEffect BillingDisputeEffect?
  stripeFeeObservation BillingStripeFeeObservation?
  stripeFeeEffect BillingStripeFeeEffect?
  invoiceFinancialOutcome BillingInvoiceFinancialOutcome?

  @@map("stripe_webhook_events")
}

model BillingVerifiedWebhookBoundary {
  id        String   @id
  startsAt  DateTime
  createdAt DateTime @default(now())

  @@map("billing_verified_webhook_boundaries")
}

// Only created after Stripe signature verification. Stripe identity is private
// and never projected to Admin; the opaque local id is the read cursor.
model BillingVerifiedWebhookDelivery {
  id         String                        @id @default(cuid())
  eventId    String
  eventType  String
  eventCreatedAt DateTime?
  // This delivery's outcome; resolvedAt separately records later event-level
  // processing of a failed delivery without erasing its original outcome.
  state      BillingVerifiedWebhookState   @default(processing)
  reason     BillingVerifiedWebhookReason?
  observedAt DateTime
  finishedAt DateTime?
  resolvedAt DateTime?

  @@index([eventId, state])
  @@index([observedAt, id])
  @@index([state, observedAt, id])
  @@map("billing_verified_webhook_deliveries")
}

model BillingInvoiceFinancialOutcome {
  sourceStripeEventId String @id
  status BillingInvoiceFinancialOutcomeStatus
  createdAt DateTime @default(now())
  sourceEvent StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@map("billing_invoice_financial_outcomes")
}

model SubscriptionLifecycleEvent {
  id                    String                             @id @default(cuid())
  sequence              BigInt                             @unique @default(autoincrement())
  // Opaque Billing identity retained even if the source Subscription is deleted.
  subscriptionId        String
  sourceStripeEventId   String                             @unique
  category              SubscriptionLifecycleEventCategory
  previousStatus        SubscriptionStatus
  nextStatus            SubscriptionStatus
  previousPlan          SubscriptionPlan
  nextPlan              SubscriptionPlan
  previousPriceUsdMinor Int?
  nextPriceUsdMinor     Int?
  currency              String                             @default("usd")
  effectiveAt           DateTime
  observedAt            DateTime                           @default(now())

  sourceEvent  StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@index([subscriptionId, effectiveAt, sequence])
  @@index([effectiveAt, sequence])
  @@index([category, effectiveAt])
  @@map("subscription_lifecycle_events")
}

model BillingMetricsHistoryBoundary {
  id                                  String   @id
  historyAvailableFrom                DateTime
  currency                            String   @default("usd")
  baselineActivePaidSubscriptions     Int
  baselineActiveProSubscriptions      Int
  baselineActivePremiumSubscriptions  Int
  baselineMonthlyRecurringRevenueMinor Int
  createdAt                           DateTime @default(now())

  @@map("billing_metrics_history_boundaries")
}

model BillingDailySubscriptionMetric {
  id                         String   @id @default(cuid())
  day                        DateTime
  currency                   String   @default("usd")
  activePaidDelta            Int      @default(0)
  activeProDelta             Int      @default(0)
  activePremiumDelta         Int      @default(0)
  monthlyRecurringRevenueDeltaMinor Int @default(0)
  newPaidSubscriptions       Int      @default(0)
  expansionMrrMinor          Int      @default(0)
  contractionMrrMinor        Int      @default(0)
  churnCount                 Int      @default(0)
  churnedMrrMinor            Int      @default(0)
  reactivationCount          Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([day, currency])
  @@index([day])
  @@map("billing_daily_subscription_metrics")
}

model BillingFinancialMetricsBoundary {
  id             String   @id
  metricsStartAt DateTime
  currency       String   @default("usd")
  createdAt      DateTime @default(now())

  @@map("billing_financial_metrics_boundaries")
}

model BillingFinancialEvent {
  id                  String                        @id @default(cuid())
  sequence            BigInt                        @unique @default(autoincrement())
  sourceStripeEventId String                        @unique
  category            BillingFinancialEventCategory
  amountMinor         BigInt
  currency            String                        @default("usd")
  effectiveAt         DateTime
  observedAt          DateTime                      @default(now())

  sourceEvent StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@index([effectiveAt, sequence])
  @@index([category, effectiveAt])
  @@map("billing_financial_events")
}

model BillingDailyFinancialMetric {
  id                     String   @id @default(cuid())
  day                    DateTime
  currency               String   @default("usd")
  grossRevenueMinor      BigInt   @default(0)
  successfulPaymentCount Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([day, currency])
  @@index([day])
  @@map("billing_daily_financial_metrics")
}

model BillingRefundMetricsBoundary {
  id             String   @id
  metricsStartAt DateTime
  currency       String   @default("usd")
  createdAt      DateTime @default(now())

  @@map("billing_refund_metrics_boundaries")
}

model BillingRefund {
  id                          String                       @id @default(cuid())
  stripeRefundId              String                       @unique
  chargeId                    String?
  paymentIntentId             String?
  amountMinor                 BigInt
  currency                    String
  currencySupport             BillingRefundCurrencySupport
  providerCreatedAt           DateTime
  firstSucceededSourceEventId String?
  firstSucceededAt            DateTime?
  createdAt                   DateTime                     @default(now())
  observations                BillingRefundObservation[]
  effect                      BillingRefundEffect?

  @@index([chargeId])
  @@index([paymentIntentId])
  @@map("billing_refunds")
}

model BillingRefundObservation {
  id                  String              @id @default(cuid())
  refundId            String
  sourceStripeEventId String              @unique
  status              BillingRefundStatus
  eventAt             DateTime
  observedAt          DateTime            @default(now())

  refund      BillingRefund      @relation(fields: [refundId], references: [id], onDelete: Restrict)
  sourceEvent StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@index([refundId, eventAt])
  @@map("billing_refund_observations")
}

model BillingRefundEffect {
  id                  String   @id @default(cuid())
  refundId            String   @unique
  sourceStripeEventId String   @unique
  amountMinor         BigInt
  currency            String   @default("usd")
  effectiveAt         DateTime
  createdAt           DateTime @default(now())

  refund      BillingRefund      @relation(fields: [refundId], references: [id], onDelete: Restrict)
  sourceEvent StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@index([effectiveAt])
  @@map("billing_refund_effects")
}

model BillingDailyRefundMetric {
  id                      String   @id @default(cuid())
  day                     DateTime
  currency                String   @default("usd")
  refundAdjustmentMinor   BigInt   @default(0)
  successfulRefundCount   Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([day, currency])
  @@index([day])
  @@map("billing_daily_refund_metrics")
}

model BillingDisputeMetricsBoundary {
  id             String   @id
  metricsStartAt DateTime
  currency       String   @default("usd")
  createdAt      DateTime @default(now())

  @@map("billing_dispute_metrics_boundaries")
}

model BillingDispute {
  id                   String               @id @default(cuid())
  stripeDisputeId      String               @unique
  chargeId             String?
  paymentIntentId      String?
  currency             String
  providerCreatedAt    DateTime
  currentStatus        BillingDisputeStatus
  currentStatusEventAt DateTime
  currentStatusEventId String
  createdAt            DateTime             @default(now())
  observations         BillingDisputeObservation[]
  effects              BillingDisputeEffect[]

  @@index([chargeId])
  @@index([paymentIntentId])
  @@map("billing_disputes")
}

model BillingDisputeObservation {
  id                   String                              @id @default(cuid())
  disputeId            String
  sourceStripeEventId  String                              @unique
  type                 BillingDisputeObservationType
  status               BillingDisputeStatus
  resolution           BillingDisputeObservationResolution
  balanceTransactionId String?
  eventAt              DateTime
  observedAt           DateTime                            @default(now())

  dispute     BillingDispute     @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  sourceEvent StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@index([disputeId, eventAt])
  @@map("billing_dispute_observations")
}

model BillingDisputeEffect {
  id                   String                     @id @default(cuid())
  disputeId            String
  sourceStripeEventId  String                     @unique
  balanceTransactionId String                     @unique
  kind                 BillingDisputeMovementKind
  amountMinor          BigInt
  currency             String                     @default("usd")
  effectiveAt          DateTime
  createdAt            DateTime                   @default(now())

  dispute     BillingDispute     @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  sourceEvent StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@unique([disputeId, kind])
  @@index([effectiveAt])
  @@map("billing_dispute_effects")
}

model BillingDailyDisputeMetric {
  id                 String   @id @default(cuid())
  day                DateTime
  currency           String   @default("usd")
  withdrawnMinor     BigInt   @default(0)
  reinstatedMinor    BigInt   @default(0)
  withdrawalCount    Int      @default(0)
  reinstatementCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([day, currency])
  @@index([day])
  @@map("billing_daily_dispute_metrics")
}

model BillingStripeFeeMetricsBoundary {
  id             String   @id
  metricsStartAt DateTime
  currency       String   @default("usd")
  createdAt      DateTime @default(now())

  @@map("billing_stripe_fee_metrics_boundaries")
}

model BillingStripeFeeObservation {
  id                   String                     @id @default(cuid())
  sourceStripeEventId  String                     @unique
  resolution           BillingStripeFeeResolution
  balanceTransactionId String?
  observedAt           DateTime                   @default(now())

  sourceEvent StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@index([observedAt])
  @@map("billing_stripe_fee_observations")
}

model BillingStripeFeeEffect {
  id                   String   @id @default(cuid())
  sourceStripeEventId  String   @unique
  balanceTransactionId String   @unique
  feeMinor             BigInt
  currency             String
  effectiveAt          DateTime
  createdAt            DateTime @default(now())

  sourceEvent StripeWebhookEvent @relation(fields: [sourceStripeEventId], references: [eventId], onDelete: Restrict)

  @@index([effectiveAt, currency])
  @@map("billing_stripe_fee_effects")
}

model BillingDailyStripeFeeMetric {
  id             String   @id @default(cuid())
  day            DateTime
  currency       String   @default("usd")
  feeMinor       BigInt   @default(0)
  feeEffectCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([day, currency])
  @@index([day])
  @@map("billing_daily_stripe_fee_metrics")
}

model BillingCombinedMetricsBoundary {
  id                 String    @id
  metricsStartAt     DateTime
  captureActivatedAt DateTime?
  currency           String    @default("usd")
  createdAt          DateTime  @default(now())

  @@map("billing_combined_metrics_boundaries")
}

model BillingFinancialEvidenceCase {
  id                  String                   @id @default(cuid())
  sourceStripeEventId String
  component           BillingEvidenceComponent
  eventType           String
  providerReference   String?
  state               BillingEvidenceState     @default(pending)
  effectiveAt         DateTime?
  attempts            Int                      @default(0)
  nextAttemptAt       DateTime                 @default(now())
  leaseExpiresAt      DateTime?
  fencingToken        Int                      @default(0)
  adminRetryDeliveryId String?                  @unique
  adminRetryKeyHash    String?                  @unique
  adminRetryFingerprint String?
  adminRetryRequestedAt DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  resolutions         BillingEvidenceResolution[]

  @@unique([sourceStripeEventId, component])
  @@index([state, nextAttemptAt, leaseExpiresAt])
  @@index([effectiveAt, component])
  @@map("billing_financial_evidence_cases")
}

model BillingEvidenceResolution {
  id          String               @id @default(cuid())
  caseId      String
  state       BillingEvidenceState
  effectiveAt DateTime?
  createdAt   DateTime             @default(now())
  case        BillingFinancialEvidenceCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, state])
  @@index([caseId, createdAt])
  @@map("billing_evidence_resolutions")
}

model BillingEventScanBoundary {
  id        String   @id
  startsAt  DateTime
  createdAt DateTime @default(now())

  @@map("billing_event_scan_boundaries")
}

model BillingEventScan {
  id               String                 @id @default(cuid())
  from             DateTime
  toExclusive      DateTime
  asOf             DateTime
  attemptedFrom    DateTime?
  attemptedToExclusive DateTime?
  verifiedFrom     DateTime?
  verifiedToExclusive DateTime?
  status           BillingEventScanStatus @default(incomplete)
  reason           String?
  providerCursor   String?
  scannedCount     Int                    @default(0)
  createdAt        DateTime               @default(now())
  completedAt      DateTime?
  findings         BillingEventScanDiscrepancy[]

  @@index([createdAt, id])
  @@index([from, toExclusive, createdAt])
  @@map("billing_event_scans")
}

model BillingEventScanDiscrepancy {
  id                  String                  @id @default(cuid())
  scanId              String
  sourceStripeEventId String
  eventType           String
  eventAt             DateTime
  finding             BillingEventScanFinding
  createdAt           DateTime                @default(now())
  scan                BillingEventScan        @relation(fields: [scanId], references: [id], onDelete: Restrict)

  @@unique([scanId, sourceStripeEventId, finding])
  @@index([scanId, eventAt, id])
  @@map("billing_event_scan_discrepancies")
}

model AiCostMetricsBoundary {
  id                 String    @id
  metricsStartAt     DateTime
  captureActivatedAt DateTime?
  createdAt          DateTime  @default(now())

  @@map("ai_cost_metrics_boundaries")
}

model AiCostIntent {
  id               String            @id
  startedAt        DateTime          @default(now())
  state            AiCostIntentState @default(pending)
  effectiveAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  events           AiCostEvent[]

  @@index([state, startedAt])
  @@index([effectiveAt])
  @@map("ai_cost_intents")
}

model AiCostEvent {
  id                 String          @id @default(cuid())
  intentId           String
  kind               AiCostEventKind
  estimatedMicroUsd  BigInt
  effectiveAt        DateTime
  createdAt          DateTime        @default(now())
  intent             AiCostIntent    @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@unique([intentId, kind])
  @@index([effectiveAt])
  @@map("ai_cost_events")
}

model AiDailyCostMetric {
  id                    String   @id @default(cuid())
  day                   DateTime @unique
  estimatedMicroUsd     BigInt   @default(0)
  costedRequestCount    Int      @default(0)
  uncostedRequestCount  Int      @default(0)
  updatedAt             DateTime @updatedAt

  @@map("ai_daily_cost_metrics")
}

model AIRequest {
  id            String           @id @default(cuid())
  userId        String
  feature       AIRequestFeature
  provider      String
  model         String?
  promptVersion String?
  tokensUsed    Int?
  cost          Float?
  latencyMs     Int?
  inputHash     String?
  cached        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@index([inputHash])
  @@map("ai_requests")
}

model UsageLimit {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  period                  String
  applicationsUsed        Int      @default(0)
  applicationsMax         Int      @default(10)
  aiRequestsUsed          Int      @default(0)
  aiRequestsMax           Int      @default(5)
  resumeOptimizationsUsed Int      @default(0)
  resumeOptimizationsMax  Int      @default(1)
  jobDiscoveriesUsed      Int      @default(0)
  jobDiscoveriesMax       Int      @default(3)
  resumesUsed             Int      @default(0)
  resumesMax              Int      @default(1)
  storageBytesUsed        Int      @default(0)
  storageBytesMax         Int      @default(5242880)
  resetAt                 DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_limits")
}

model QuotaGrant {
  id                 String             @id @default(cuid())
  targetUserId       String
  category           QuotaGrantCategory
  amount             Int
  expiresAt          DateTime
  reason             QuotaGrantReason
  grantedByUserId    String?
  idempotencyKeyHash String
  requestFingerprint String
  effectiveLimitAtCreation Int
  remainingAtCreation      Int
  createdAt          DateTime           @default(now())

  targetUser User @relation("QuotaGrantTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("QuotaGrantActor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([grantedByUserId, idempotencyKeyHash])
  @@index([targetUserId, category, expiresAt])
  @@map("quota_grants")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(in_app)
  title     String
  body      String?
  link      String?
  status    NotificationStatus  @default(pending)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String?
  type      ActivityType
  metadata  Json?
  ipAddress String?
  userAgent String?
  actorUserId String?
  targetType String?
  targetId String?
  action String?
  before Json?
  after Json?
  correlationId String?
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("activity_logs")
}

model Session {
  id                String            @id @default(cuid())
  userId            String
  token             String            @unique
  userAgent         String?
  ipAddress         String?
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  mfaVerifiedAt     DateTime?
  clientType        SessionClientType @default(web)
  lastUsedAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model RefreshTokenHistory {
  id         String    @id @default(cuid())
  sessionId  String
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime  @default(now())
  detectedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token_history")
}

model IdempotencyRecord {
  id          String            @id @default(cuid())
  userId      String
  key         String
  operation   String
  fingerprint String
  status      IdempotencyStatus @default(pending)
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AdminStepUpMfaProof {
  id          String   @id @default(cuid())
  proofHash   String   @unique
  actorUserId String
  sessionId   String
  action      String
  targetType  String
  targetId    String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([actorUserId, sessionId, action, targetType, targetId, expiresAt])
  @@map("admin_step_up_mfa_proofs")
}

model AdminStepUpMfaAttempt {
  id              String   @id @default(cuid())
  actorUserId     String
  sessionId       String
  action          String
  targetType      String
  targetId        String
  failedAttempts  Int      @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([actorUserId, sessionId, action, targetType, targetId])
  @@index([lockedUntil])
  @@map("admin_step_up_mfa_attempts")
}
