+api_secret_json="$(
+  kubectl get secret api-secrets \
+    --namespace "$K8S_NAMESPACE" \
+    --output json
+)"
+
+secret_has_value() {
+  local secret_key="$1"
+  jq --exit-status \
+    --arg key "$secret_key" \
+    '.data[$key] | type == "string" and length > 0' \
+    <<<"$api_secret_json" >/dev/null
