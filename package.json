{
  "name": "applyai",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "generate": "pnpm --filter @applyai/api prisma:generate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "audit:dependencies": "pnpm audit --audit-level=low",
    "check": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:dependencies"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.15",
      "brace-expansion": "5.0.9",
      "js-yaml": "5.2.2",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "qs": "6.16.0",
      "sharp": "0.35.4",
      "multer": "2.3.0"
    }
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  }
}
