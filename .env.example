# ── Core ──
NODE_ENV=development
PORT=3001

# ── Database ──
DATABASE_URL=postgresql://applyai:applyai_dev@localhost:5432/applyai

# ── Redis ──
# Required in production: set the shared managed Redis/Valkey URL explicitly
# (usually a `rediss://` URL). The localhost value is for development only.
REDIS_URL=redis://localhost:6379

# ── Runtime roles ──
# `all` is suitable only for local development. The public API uses `api`;
# worker containers use `worker`. AI_EXECUTION_ROLE bounds provider reachability:
# all=local/single-process, free=GLM-only Free worker, paid=paid-only worker.
APP_PROCESS_ROLE=all
AI_EXECUTION_ROLE=all
# Temporary maintenance-only mode. It requires APP_PROCESS_ROLE=worker and
# drains unsigned legacy `resume-parse` jobs to the DLQ without parsing,
# re-signing, or calling an AI provider. Keep false during normal operation.
RESUME_PARSE_LEGACY_DRAIN_ENABLED=false

# ── Beta registration gate ──
# Set BETA_MODE=true only while the closed beta is active. The cap is enforced
# atomically for password and OAuth registration; existing OAuth users do not
# consume another slot when signing in.
BETA_MODE=false
BETA_MAX_REGISTRATIONS=100

# ── Error monitoring (disabled by default) ──
# Sentry initializes only when SENTRY_ENABLED is exactly "true". When enabled,
# a valid DSN is required at startup. Events are aggressively allow-listed and
# envelope filtering drops sessions, replays, traces, logs, metrics, and files.
# No CVs, prompts, generated documents, request bodies, cookies, headers,
# tokens, or user data leave ApplyAI through Sentry.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# ── Auth ──
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
AUTH_LOGIN_LOCKOUT_THRESHOLD=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Required in production. Generate a 32-byte base64 key with:
# `openssl rand -base64 32`
# Keep independent from JWT_SECRET; see docs/MFA_KEY_OPERATIONS.md.
MFA_ENCRYPTION_KEY=
# Required in production and by any process that uploads or consumes resume
# jobs. Generate independently with `openssl rand -base64 32`; never reuse
# JWT_SECRET or MFA_ENCRYPTION_KEY.
RESUME_QUEUE_SIGNING_KEY=

# ── OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# ── AI Providers ──
# Free-plan product AI has a separate, server-only GLM adapter. It is required
# only in a process able to execute Free jobs (AI_EXECUTION_ROLE=all or free).
# Use your GLM gateway's documented OpenAI-compatible base URL and model name.
# Do not expose any GLM value as NEXT_PUBLIC_*.
FREE_AI_PROVIDER=glm
GLM_FREE_PLAN_API_KEY=
GLM_FREE_PLAN_MODEL=
GLM_FREE_PLAN_BASE_URL=
GLM_FREE_PLAN_TIMEOUT_MS=30000
GLM_FREE_PLAN_MAX_OUTPUT_TOKENS=2048
GLM_FREE_PLAN_MAX_INPUT_BYTES=100000

# Pro/Premium use the existing paid provider chain only. GLM is never a paid
# fallback and a Free failure never consumes a paid provider attempt.
AI_PROVIDER=openai
# Set these to the selected model's current USD rates; production rejects zero values.
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_MAX_INPUT_BYTES=100000
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_REQUEST_COST_USD=0.50
# Total upper bound across all paid-provider attempts for one request.
AI_MAX_FALLBACK_TOTAL_COST_USD=0.50
AI_MAX_PROVIDER_ATTEMPTS=3
AI_FALLBACK_TOTAL_TIMEOUT_MS=30000
AI_FALLBACK_PROVIDERS=claude,gemini
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AI_CIRCUIT_BREAKER_RESET_MS=30000
PARTNER_API_TIMEOUT_MS=15000
PARTNER_API_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
PARTNER_API_CIRCUIT_BREAKER_RESET_MS=30000
# Comma-separated approved ATS boards. Examples:
# greenhouse:board-token,lever:site-name,ashby:job-board-name
JOB_DISCOVERY_SOURCES=
JOB_DISCOVERY_REFRESH_TTL_MINUTES=30
JOB_DISCOVERY_MAX_JOB_AGE_HOURS=168
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_OUTPUT_TOKENS=
ANTHROPIC_INPUT_COST_PER_MILLION=
ANTHROPIC_OUTPUT_COST_PER_MILLION=
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_INPUT_COST_PER_MILLION=
GEMINI_OUTPUT_COST_PER_MILLION=

# ── Independent Morocco career chatbot (Dahl) ──
# This provider is intentionally separate from AI_PROVIDER and its CV/application
# quotas. Keep the real key server-side and rotate any key shared in chat/logs.
# Set standalone mode only on a deployment dedicated to Nori. It starts a minimal
# runtime that does not load PostgreSQL, BullMQ, JWT auth, billing, or resume
# storage. Production standalone mode still requires REDIS_URL for global limits
# and an explicit TRUST_PROXY_HOPS value (1 when deployed directly on Vercel).
CAREER_CHAT_STANDALONE=false
# The CAREER_CHAT_* and DAHL_CAREER_CHAT_* values belong only to the dedicated
# Nori deployment. The full ApplyAI API does not load the Career Assistant.
CAREER_CHAT_ENABLED=false
DAHL_CAREER_CHAT_API_KEY=
DAHL_CAREER_CHAT_BASE_URL=https://inference.dahl.global/v1
DAHL_CAREER_CHAT_MODEL=MiniMaxAI/MiniMax-M2.7
DAHL_CAREER_CHAT_TIMEOUT_MS=30000
DAHL_CAREER_CHAT_MAX_OUTPUT_TOKENS=700
DAHL_CAREER_CHAT_MAX_REQUEST_TOKENS=3500
DAHL_CAREER_CHAT_DAILY_TOKEN_BUDGET=250000
DAHL_CAREER_CHAT_MONTHLY_TOKEN_BUDGET=5000000
DAHL_CAREER_CHAT_MAX_RETRIES=2
DAHL_CAREER_CHAT_RETRY_BASE_DELAY_MS=200
DAHL_CAREER_CHAT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
DAHL_CAREER_CHAT_CIRCUIT_BREAKER_RESET_MS=30000
DAHL_CAREER_CHAT_HEALTH_TIMEOUT_MS=3000

# ── AWS S3 ──
STORAGE_DRIVER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# `S3_BUCKET_RESUMES` is the established ApplyAI bucket setting. Leave
# S3_ENDPOINT empty for AWS S3; configure the S3-compatible values for R2.
S3_BUCKET_RESUMES=applyai-resumes
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# These IDs are validated at checkout: Pro must be USD $19/month and Premium
# must be USD $49/month, both active monthly recurring prices.
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled

# ── Email (optional SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── App ──
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# This DSN is intentionally public and is only used by the dashboard SDK. It
# must be distinct from the API SENTRY_DSN if you create separate Sentry projects.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
# Dashboard server and edge monitoring are controlled separately from browser
# monitoring. Do not use NEXT_PUBLIC_SENTRY_ENABLED for server or edge code.
DASHBOARD_SENTRY_ENABLED=false
DASHBOARD_SENTRY_DSN=
DASHBOARD_SENTRY_ENVIRONMENT=
DASHBOARD_SENTRY_RELEASE=
# ── Dashboard early-beta registration (server-only) ──
# Leave these empty until a staging Google Sheet is prepared. Never use
# NEXT_PUBLIC_* variables for these values and never commit the private key.
EARLY_USERS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
EARLY_USERS_SHEET_NAME=Early Users
# Public origin of the separate, standalone Nori API. It must not point to the
# authenticated ApplyAI API and never contains the Dahl key.
NEXT_PUBLIC_CAREER_CHAT_API_URL=http://localhost:3002
VITE_API_BASE_URL=http://localhost:3001
VITE_DASHBOARD_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=
EXTENSION_ID=
# Set to the exact number of trusted reverse-proxy hops so IP fallback cannot
# be spoofed through X-Forwarded-For. Keep 0 when the API is directly exposed.
TRUST_PROXY_HOPS=0
